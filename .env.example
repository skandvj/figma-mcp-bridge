FIGMA_MODE=demo
FIGMA_ACCESS_TOKEN=
FIGMA_FILES_CONFIG=figma.files.json
FIGMA_PRODUCT=web-app

# Legacy single-file fallback if you do not use figma.files.json.
FIGMA_FILE_KEY=

MCP_TRANSPORT=stdio
MCP_PORT=3100
MCP_API_KEY=
MCP_BASIC_AUTH_USERNAME=
MCP_BASIC_AUTH_PASSWORD=
FIGMA_WEBHOOK_SECRET=
FIGMA_CACHE_PATH=./figma-cache.sqlite
FIGMA_CACHE_TTL_MS=300000

CODEGEN_CONFIG_PATH=codegen.config.json
CODEGEN_TEAM_PACKAGE=@company/ui
CODEGEN_ALLOWED_FRAMEWORKS=react,vue,svelte
CODEGEN_COMPONENT_STRATEGY=wrap-existing
CODEGEN_TOKEN_NAMING=prefixed-css-var
CODEGEN_TOKEN_PREFIX=ds

RUN_LIVE_FIGMA_TESTS=false
